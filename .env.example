# --- Instagram login ---
# Preferred: browser se sessionid copy karo
# (DevTools > Application > Cookies > https://www.instagram.com > sessionid)
IG_SESSIONID=

# Fallback agar sessionid nahi hai
IG_USERNAME=
IG_PASSWORD=

# --- Which group chats to watch (comma separated thread ids) ---
# Run `python bot.py threads` to find the ids
THREAD_IDS=

# --- Reply behaviour ---
# smart   = questions + @mentions + 20% random (group active rakhne ke liye)
# mention = only when someone tags the bot
# all     = reply to every message
# off     = don't reply at all
REPLY_MODE=smart
ACTIVE_CHANCE=0.45

# --- Polling (kitni jaldi naye messages check ho) ---
POLL_MIN_SECONDS=3
POLL_MAX_SECONDS=6

# --- Memory database ---
DB_PATH=memory.db
# Kitne recent messages LLM ko context me diye jaye
HISTORY_LIMIT=25
# Itne naye messages ke baad purani baaton ka summary banta hai
SUMMARY_EVERY=60
SUMMARY_KEEP=80

# --- LLM (ek hi model, koi bhi OpenAI-compatible endpoint) ---
# Gemini (free tier): https://generativelanguage.googleapis.com/v1beta/openai
# OpenAI:            https://api.openai.com/v1
# Groq:              https://api.groq.com/openai/v1
# Local Ollama:      http://localhost:11434/v1  (no key needed)
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-2.5-flash

# --- Optional ---
# PROXY=http://user:pass@host:port

# Cloud (Render) ke liye — wake-up hours IST me rahen
BOT_TIMEZONE=Asia/Kolkata

# Optional: Render free plan ka disk ephemeral hai. Memory ko GitHub Gist me
# auto-backup karke restart ke baad wapas laane ke liye:
# GIST_ID=abc123...
# GITHUB_TOKEN=ghp_...   (gist scope)
# BACKUP_INTERVAL_SECONDS=300

LLM_TIMEOUT_SECONDS=8
REPLY_GAP_SECONDS=45
TYPING_MIN_SECONDS=3
TYPING_MAX_SECONDS=10
WAKE_AFTER_MINUTES=45
WAKE_MIN_GAP_MINUTES=120
WAKE_MAX_PER_DAY=3
WAKE_HOUR_START=9
WAKE_HOUR_END=24
